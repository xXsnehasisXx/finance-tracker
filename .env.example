# LangSmith (optional; tracing stays off without a key)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AI-Readiness-POC-02-P2

ANONYMIZED_TELEMETRY=False
