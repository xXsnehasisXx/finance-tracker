CORS_ORIGINS=http://localhost:3000

# AI (Phases 2-5)
API_BASE_URL=http://localhost:8000/api/v1
GOOGLE_API_KEY=
# POC says Gemini 2.0 Flash (shut down by Google); see docs/DEPENDENCY_DEVIATIONS.md
